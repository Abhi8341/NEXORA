class WeatherScreen(Screen):

    def __init__(self, **kwargs):

        super().__init__(**kwargs)

        root = BoxLayout(
            orientation="vertical",
            padding=dp(16),
            spacing=dp(10)
        )

        root.add_widget(
            title_label(
                "🌦️ Live Weather",
                27
            )
        )

        self.city = TextInput(
            hint_text="Enter city",
            multiline=False,
            size_hint_y=None,
            height=dp(50),
            padding=[dp(15), dp(12)],
            background_color=CARD,
            foreground_color=WHITE,
            hint_text_color=GRAY
        )

        root.add_widget(self.city)

        get = NButton(
            text="Get Live Weather",
            bg=BLUE
        )

        get.bind(
            on_release=self.get_weather
        )

        root.add_widget(get)

        self.result = Label(
            text="Enter a city and tap the button.",
            font_size=16,
            color=GRAY,
            halign="left",
            valign="top"
        )

        root.add_widget(self.result)

        root.add_widget(Widget())

        root.add_widget(
            NButton(
                text="← Home",
                bg=BLUE,
                on_release=lambda x:
                setattr(
                    self.manager,
                    "current",
                    "home"
                )
            )
        )

        self.add_widget(root)

    def get_weather(self, instance):

        city = self.city.text.strip()

        if not city:
            self.result.text = "Please enter a city."
            return

        self.result.text = "Loading live weather..."

        threading.Thread(
            target=self.fetch_weather,
            args=(city,),
            daemon=True
        ).start()

    def fetch_weather(self, city):

        try:

            geo_response = requests.get(
                "https://geocoding-api.open-meteo.com/v1/search",
                params={
                    "name": city,
                    "count": 1,
                    "language": "en",
                    "format": "json"
                },
                timeout=10
            )

            geo = geo_response.json()

            places = geo.get(
                "results",
                []
            )

            if not places:

                self.update_result(
                    "City not found."
                )

                return

            place = places[0]

            response = requests.get(
                "https://api.open-meteo.com/v1/forecast",
                params={
                    "latitude": place["latitude"],
                    "longitude": place["longitude"],
                    "current": (
                        "temperature_2m,"
                        "relative_humidity_2m,"
                        "apparent_temperature,"
                        "weather_code,"
                        "wind_speed_10m"
                    ),
                    "timezone": "auto"
                },
                timeout=10
            )

            data = response.json()

            current = data.get(
                "current",
                {}
            )

            temperature = current.get(
                "temperature_2m",
                "?"
            )

            feels = current.get(
                "apparent_temperature",
                "?"
            )

            humidity = current.get(
                "relative_humidity_2m",
                "?"
            )

            wind = current.get(
                "wind_speed_10m",
                "?"
            )

            description = self.describe_weather(
                current.get(
                    "weather_code",
                    -1
                )
            )

            self.update_result(
                f"📍 {place.get('name', city)}\n"
                f"{place.get('country', '')}\n\n"
                f"🌡️ Temperature: {temperature}°C\n"
                f"🌡️ Feels like: {feels}°C\n"
                f"💧 Humidity: {humidity}%\n"
                f"💨 Wind: {wind} km/h\n\n"
                f"☁️ {description}"
            )

        except Exception:

            self.update_result(
                "Weather could not be loaded.\n\n"
                "Check your internet connection."
            )

    def describe_weather(self, code):

        weather = {
            0: "Clear sky",
            1: "Mainly clear",
            2: "Partly cloudy",
            3: "Overcast",
            45: "Fog",
            48: "Fog",
            51: "Light drizzle",
            53: "Drizzle",
            55: "Heavy drizzle",
            61: "Light rain",
            63: "Rain",
            65: "Heavy rain",
            71: "Light snow",
            73: "Snow",
            75: "Heavy snow",
            80: "Rain showers",
            81: "Rain showers",
            82: "Heavy rain showers",
            95: "Thunderstorm",
            96: "Thunderstorm with hail",
            99: "Thunderstorm with heavy hail"
        }

        return weather.get(
            code,
            "Weather information"
        )

    def update_result(self, text):

        Clock.schedule_once(
            lambda dt:
            setattr(
                self.result,
                "text",
                text
            )
        )


