# ============================================================
# BUTTON
# ============================================================

class NButton(Button):

    def __init__(
        self,
        text="",
        bg=BLUE,
        font=14,
        height=52,
        **kwargs
    ):
        super().__init__(**kwargs)

        self.text = text
        self.font_size = font

        self.background_normal = ""
        self.background_down = ""
        self.background_color = bg

        self.color = WHITE
        self.bold = True

        self.size_hint_y = None
        self.height = dp(height)


