                27
            )
        )

        self.city = TextInput(
            hint_text="Enter city or area",
            multiline=False,
            size_hint_y=None,
            height=dp(50),
            padding=[dp(15), dp(12)],
            background_color=CARD,
            foreground_color=WHITE,
            hint_text_color=GRAY
        )

        root.add_widget(self.city)

        # Category buttons
        grid = GridLayout(
            cols=3,
            spacing=dp(6),
            size_hint_y=None,
            height=dp(220)
        )

        categories = [
            ("🏥", "Hospital", "hospital"),
            ("🏦", "Bank", "bank"),
            ("🏫", "School", "school"),
            ("🏛️", "Government", "government"),
            ("🚉", "Railway", "railway"),
            ("🛒", "Market", "market"),
            ("🚌", "Bus Stop", "bus"),
            ("🚕", "Taxi", "taxi"),
            ("✈️", "Airport", "airport")
        ]

        for icon, text, category in categories:

            b = NButton(
                text=f"{icon}\n{text}",
                bg=CARD,
                font=10,
                height=65
            )

            b.bind(
                on_release=lambda x, c=category:
                self.search(c)
            )

            grid.add_widget(b)

        root.add_widget(grid)

        self.status = Label(
            text="Enter a location and choose a category.",
            font_size=12,
            color=GRAY,
            size_hint_y=None,
            height=dp(35)
        )

        root.add_widget(self.status)

        scroll = ScrollView()

        self.results = BoxLayout(
            orientation="vertical",
            spacing=dp(8),
            size_hint_y=None
        )

        self.results.bind(
            minimum_height=self.results.setter(
                "height"
            )
        )

        scroll.add_widget(
            self.results
        )

        root.add_widget(scroll)

        root.add_widget(
            NButton(
                text="← Home",
                bg=BLUE,
                on_release=lambda x:
                setattr(
                    self.manager,
                    "current",
                    "home"
                )
            )
        )

        self.add_widget(root)

    # ========================================================
    # SEARCH
    # ========================================================

    def search(self, category):

        city = self.city.text.strip()

        if not city:

            self.status.text = (
                "Please enter a city or area first."
            )

            return

        self.results.clear_widgets()

        self.status.text = (
            "Searching nearby places..."
        )

        threading.Thread(
            target=self.find_places,
            args=(city, category),
            daemon=True
        ).start()

    # ========================================================
    # FIND PLACES
    # ========================================================

    def find_places(
        self,
        city,
        category
    ):

        try:

            headers = {
                "User-Agent":
                "NEXORA-Public/3.3"
            }

            # ------------------------------------------------
            # Geocoding
            # ------------------------------------------------

            geo_response = requests.get(
                "https://nominatim.openstreetmap.org/search",
                params={
                    "q": city,
                    "format": "json",
                    "limit": 1
                },
                headers=headers,
                timeout=15
            )

            geo = geo_response.json()

            if not geo:

                self.update_status(
                    "Location not found."
                )

                return

            latitude = float(
                geo[0]["lat"]
            )

            longitude = float(
                geo[0]["lon"]
            )

            # ------------------------------------------------
            # OpenStreetMap categories
            # ------------------------------------------------

            filters = {

                "hospital":
                    '["amenity"="hospital"]',

                "bank":
                    '["amenity"="bank"]',

                "school":
                    '["amenity"="school"]',

                "government":
                    '["office"="government"]',

                "railway":
                    '["railway"="station"]',

                "market":
                    '["shop"="supermarket"]',

                "bus":
                    '["highway"="bus_stop"]',

                "taxi":
                    '["amenity"="taxi"]',

                "airport":
                    '["aeroway"="aerodrome"]'
            }

            osm_filter = filters.get(
                category
            )

            if not osm_filter:

                self.update_status(
                    "Unknown category."
                )

                return

            # ------------------------------------------------
            # Overpass query
            # ------------------------------------------------

            query = f"""
[out:json][timeout:25];
(
  node{osm_filter}(around:15000,{latitude},{longitude});
  way{osm_filter}(around:15000,{latitude},{longitude});
  relation{osm_filter}(around:15000,{latitude},{longitude});
);
out center tags;
"""

            response = requests.post(
                "https://overpass-api.de/api/interpreter",
                data=query,
                headers=headers,
                timeout=35
            )

            data = response.json()

            elements = data.get(
                "elements",
                []
            )

            found = []
            seen = set()

            # ------------------------------------------------
            # Process results
            # ------------------------------------------------

            for item in elements:

                tags = item.get(
                    "tags",
                    {}
                )

                name = tags.get(
                    "name"
                )

                if not name:
                    continue

                key = name.lower().strip()

                if key in seen:
                    continue

                seen.add(key)

                address_parts = []

                for field in [
                    "addr:housenumber",
                    "addr:street",
                    "addr:city",
                    "addr:postcode"
                ]:

                    if tags.get(field):
                        address_parts.append(
                            tags[field]
                        )

                address = ", ".join(
                    address_parts
                )

                # Get coordinates
                place_lat = item.get(
                    "lat"
                )

                place_lon = item.get(
                    "lon"
                )

                if place_lat is None:

                    center = item.get(
                        "center",
                        {}
                    )

                    place_lat = center.get(
                        "lat"
                    )

                    place_lon = center.get(
                        "lon"
                    )

                found.append(
                    (
                        name,
                        address,
                        place_lat,
                        place_lon
                    )
                )

                if len(found) >= 30:
                    break

            Clock.schedule_once(
                lambda dt, f=found:
                self.display_results(f)
            )

        except Exception as error:

            print(
                "Search error:",
                error
            )

            self.update_status(
                "Could not load places.\n"
                "Please check your internet connection."
            )

    # ========================================================
    # DISPLAY RESULTS
    # ========================================================

    def display_results(self, places):

        self.results.clear_widgets()

        if not places:

            self.status.text = (
                "No named places found nearby."
            )

            return

        self.status.text = (
            f"Found {len(places)} places."
        )

        for name, address, lat, lon in places:

            card = BoxLayout(
                orientation="vertical",
                spacing=dp(4),
                size_hint_y=None,
                height=dp(105)
            )

            text = f"📍 {name}"

            if address:
                text += f"\n{address}"

            else:
                text += "\nAddress not available"

            label = Label(
                text=text,
                font_size=12,
                color=WHITE,
                halign="left",
                valign="middle"
            )

            card.add_widget(label)

            maps_button = NButton(
                text="🗺️  Open in Maps",
                bg=GREEN,
                font=12,
                height=42
            )

            maps_button.bind(
                on_release=lambda x,
                n=name,
                a=address,
                la=lat,
                lo=lon:
                self.open_maps(
                    n,
                    a,
                    la,
                    lo
                )
            )

            card.add_widget(
                maps_button
            )

            self.results.add_widget(
                card
            )

    # ========================================================
    # OPEN MAPS
    # ========================================================

    def open_maps(
        self,
        name,
        address,
        latitude,
        longitude
    ):

        try:

            # Exact coordinates are preferred.
            if (
                latitude is not None
                and longitude is not None
            ):

                maps_url = (
                    "https://www.google.com/maps/"
                    "search/?api=1&query="
                    f"{latitude},{longitude}"
                )

            else:

                query = name

                if address:
                    query += " " + address

                maps_url = (
                    "https://www.google.com/maps/"
                    "search/?api=1&query="
                    + quote(query)
                )

            webbrowser.open(
                maps_url
            )

        except Exception as error:

            print(
                "Maps error:",
                error
            )

    def update_status(self, text):

        Clock.schedule_once(
            lambda dt:
            setattr(
                self.status,
                "text",
                text
            )
        )


