class NexoraPublicApp(App):

    def build(self):

        self.title = "NEXORA Public"

        manager = ScreenManager(
            transition=FadeTransition(
                duration=0.2
            )
        )

        manager.add_widget(
            SplashScreen(
                name="splash"
            )
        )

        manager.add_widget(
            HomeScreen(
                name="home"
            )
        )

        manager.add_widget(
            WeatherScreen(
                name="weather"
            )
        )

        manager.add_widget(
            PlacesScreen(
                name="places"
            )
        )

        manager.add_widget(
            UpdatesScreen(
                name="updates"
            )
        )

        manager.add_widget(
            SettingsScreen(
                name="settings"
            )
        )

        manager.current = "splash"

        Clock.schedule_once(
            self.open_home,
            1.5
        )

        return manager

    def open_home(self, dt):

        if self.root.has_screen("home"):
            self.root.current = "home"


